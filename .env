# Docker Build Configuration
CUDA="13.2.0"
FLAVOR="cudnn-devel"
OS="ubi8"
BASE_IMG="docker.io/nvidia/cuda"
OUT_IMG="cuda-builder"
LLAMA_REPO="https://github.com/ggml-org/llama.cpp.git"
DOCKERFILE_BASE="BASE.Dockerfile"
MAKEFILE="Makefile"
LLAMA_DIR_NAME="llama.cpp"
PREPEND="# syntax = docker/dockerfile:experimental"
LABEL="${CUDA}-${FLAVOR}-${OS}"
IMG="${BASE_IMG}:${LABEL}"
FULL_PREPEND="${PREPEND}\nFROM ${IMG}\n"
DOCKERFILE_UBI="${LABEL}.Dockerfile"
TARGET="package_dynamic" # Can be package_static, package_dynamic, or package (for both)

# Makefile Configuration
ARCHS="86;89"
BUILD_STATIC="build_static"
DIST_STATIC="dist_static"
PKG_STATIC="llama-cuda86-89-static-portable.tar.gz"

BUILD_DYNAMIC="build_dynamic"
DIST_DYNAMIC="dist_dynamic"
PKG_DYNAMIC="llama-cuda86-89-dynamic-portable.tar.gz"
