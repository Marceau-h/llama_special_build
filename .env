# Docker Build Base Configuration
NO_CACHE="false"
OS="ubi8"
CUDA="13.2.1"
FLAVOR="cudnn-devel"
LABEL="${CUDA}-${FLAVOR}-${OS}"

BASE_IMG="docker.io/nvidia/cuda"
IMG="${BASE_IMG}:${LABEL}"
PREPEND="# syntax = docker/dockerfile:experimental\nFROM ${IMG}\n"

OUT_IMG="cuda-builder"
DOCKER_USER="marceauh"
GHCR_USER="Marceau-h"
DOCKER_IMAGE_NAME="${DOCKER_USER}/${OUT_IMG}:${LABEL}"
GHCR_IMAGE_NAME="ghcr.io/${GHCR_USER}/${OUT_IMG}:${LABEL}"

# Repository Configuration
LLAMA_REPO="https://github.com/ggml-org/llama.cpp.git"
LLAMA_DIR_NAME="llama.cpp"
# LLAMA_REF options:
# - "master":
# - "latest_tag"
# - specific tag: e.g. "v0.9.0"
LLAMA_REF="master"
DOCKERFILE_BASE="Dockerfile"
MAKEFILE="Makefile"
BUILD_DIR="build"

# Target Configuration
# Available Targets:
# - default_static, default_dynamic, default_package
# - full_static, full_dynamic, full_package
# - tailored_static, tailored_dynamic, tailored_package
TARGET="tailored_package"