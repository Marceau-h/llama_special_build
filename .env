# Docker Build Base Configuration
CUDA="13.2.0"
FLAVOR="cudnn-devel"
BASE_IMG="docker.io/nvidia/cuda"
OUT_IMG="cuda-builder"
DOCKER_USER="marceauh"

# Repository Configuration
LLAMA_REPO="https://github.com/ggml-org/llama.cpp.git"
LLAMA_DIR_NAME="llama.cpp"
DOCKERFILE_BASE="BASE.Dockerfile"
MAKEFILE="Makefile"

# Target Configuration
# Available Targets:
# - default_static, default_dynamic, default_package
# - full_static, full_dynamic, full_package
# - tailored_static, tailored_dynamic, tailored_package
TARGET="tailored_package"
